# Environment Variables — CrimeAssist AI Backend
# Copy this file to .env and fill in actual values

# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# ─── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://crimeassist:your_password@localhost:5432/crimeassist_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crimeassist_db
DB_USER=crimeassist
DB_PASSWORD=your_secure_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# ─── JWT Authentication ──────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_64_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# ─── Zoho Catalyst ──────────────────────────────────────
CATALYST_PROJECT_ID=your_catalyst_project_id
CATALYST_PROJECT_KEY=your_catalyst_project_key
CATALYST_ENV=Development
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_DC=in

# ─── Redis Cache ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=3600
REDIS_TTL_ANALYTICS=300

# ─── Email (Nodemailer) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CrimeAssist AI <noreply@ksp.gov.in>"

# ─── Security ────────────────────────────────────────────
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
ENCRYPTION_KEY=your_32_char_encryption_key_here

# ─── File Storage ────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs

# ─── Frontend URL ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
